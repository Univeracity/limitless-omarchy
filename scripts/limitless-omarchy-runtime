#!/usr/bin/env bash
# Local runtime owned by the Limitless Omarchy panel.
#
# It never installs globally. Setup is invoked only by an explicit UI action
# and creates an isolated runtime beneath the user's XDG data directory.

set -euo pipefail

status_json() {
  local mode=$1
  local reason=$2
  printf '%s\n' \
    "{\"schemaVersion\":\"limitless.omarchy-status/0.1\",\"mode\":\"${mode}\",\"service\":{\"connected\":false,\"reason\":\"${reason}\"}}"
}

fail() {
  printf 'limitless-omarchy runtime: %s\n' "$1" >&2
  exit 2
}

usage() {
  cat <<'USAGE'
Usage: limitless-omarchy-runtime ACTION --plugin-root PATH [--profile PATH] [--omarchy-release VALUE] [--additional-agent ID]

Actions:
  status      report whether the panel-owned local runtime is available
  panel-state load the complete local panel projection in one process
  setup       explicitly create or update the isolated local runtime
  query       query the owner-local catalog before an Omarchy customization
  agent-status show the current Omarchy default and local MCP connection state
  agent-reconcile connect the default agent and selected additional agents to local MCP
  agent-disconnect remove only plugin-owned local MCP connections
  stats       show private aggregate activity counters
  settings-show show saved owner-controlled Library settings
  settings-apply validate and save settings from bounded JSON stdin
  draft-list  list locally registered reusable-method candidates
  register-method register one concise method from bounded JSON stdin
  contribution-sync retry queued sharing work without blocking registration
  contribution-transition move one method between owner-selected sharing destinations
  service-activate enable the release-pinned official service
  service-inspect  verify the enabled official service
  service-query    read one managed query as a bounded JSON line from stdin
  service-publication read one explicit publication action from bounded stdin
  service-artifact-stage redeem one exact-artifact continuation from bounded stdin
  service-artifact-review materialize and validate one exact Omarchy bundle from bounded stdin
  service-artifact-install install reviewed exact bytes disabled from bounded stdin
  service-artifact-enable explicitly enable one signed installation from bounded stdin

The panel invokes this script itself. It is also intentionally usable as a
lower-level diagnostic surface; it never installs into the system Python.
USAGE
}

action=${1:-}
[[ -n $action ]] || { usage >&2; exit 2; }
shift

plugin_root=""
profile=""
omarchy_release=""
additional_agents=()
while (($#)); do
  case "$1" in
    --plugin-root)
      (($# >= 2)) || fail "--plugin-root requires a directory"
      plugin_root=$2
      shift 2
      ;;
    --profile)
      (($# >= 2)) || fail "--profile requires a file"
      profile=$2
      shift 2
      ;;
    --omarchy-release)
      (($# >= 2)) || fail "--omarchy-release requires a value"
      omarchy_release=$2
      shift 2
      ;;
    --additional-agent)
      (($# >= 2)) || fail "--additional-agent requires an Omarchy agent id"
      additional_agents+=("$2")
      shift 2
      ;;
    --help|-h)
      usage
      exit 0
      ;;
    *)
      fail "unrecognized argument: $1"
      ;;
  esac
done

case "$action" in
  status|panel-state|setup|query|agent-status|agent-reconcile|agent-disconnect|stats|settings-show|settings-apply|draft-list|register-method|contribution-sync|contribution-transition|service-activate|service-inspect|service-query|service-publication|service-artifact-stage|service-artifact-review|service-artifact-install|service-artifact-enable) ;;
  *)
    fail "unrecognized action: $action"
    ;;
esac

[[ -n $plugin_root && -d $plugin_root && -f $plugin_root/pyproject.toml ]] \
  || fail "a readable plugin root is required"
plugin_root=$(cd -- "$plugin_root" && pwd -P)

if [[ -z ${XDG_DATA_HOME:-} || $XDG_DATA_HOME != /* ]]; then
  if [[ $action == status ]]; then
    status_json "setup-required" "xdg-data-home-unavailable"
    exit 0
  fi
  fail "XDG_DATA_HOME must name an absolute directory"
fi

runtime_root=$XDG_DATA_HOME/limitless-omarchy
runtime=$runtime_root/runtime
runtime_cli=$runtime/bin/limitless-omarchy
agent_state_dir=$runtime_root/agent-connection
activity_path=$runtime_root/activity.json
catalog_root=$runtime_root/catalog
drafts_path=$runtime_root/drafts
if [[ -n ${XDG_CONFIG_HOME:-} && $XDG_CONFIG_HOME == /* ]]; then
  settings_path=$XDG_CONFIG_HOME/limitless-omarchy/settings.json
elif [[ -n ${HOME:-} && $HOME == /* ]]; then
  settings_path=$HOME/.config/limitless-omarchy/settings.json
else
  settings_path=$runtime_root/settings.json
fi
runtime_available() {
  [[ -d $runtime && ! -L $runtime && -x $runtime_cli && ! -L $runtime_cli ]]
}

sync_seed_catalog() {
  local source target stage name existing
  mkdir -p -- "$catalog_root"
  [[ -d $catalog_root && ! -L $catalog_root ]] || fail "the owner-local catalog root is unsafe"

  # Seed projections are replaceable plugin-owned material. Agent-created
  # local-* projections are deliberately outside this namespace and survive
  # runtime updates.
  for existing in "$catalog_root"/seed-*; do
    [[ -e $existing || -L $existing ]] || continue
    [[ $existing == "$catalog_root"/seed-* && -d $existing && ! -L $existing ]] \
      || fail "a packaged catalog projection is unsafe"
    rm -rf -- "$existing"
  done
  for source in "$plugin_root"/catalog/*; do
    [[ -d $source && ! -L $source && -f $source/capsule.json && ! -L $source/capsule.json ]] || continue
    name=${source##*/}
    [[ $name =~ ^[A-Za-z0-9._-]+$ ]] || fail "a packaged catalog entry has an unsafe name"
    target=$catalog_root/seed-$name
    stage=$(mktemp -d "$catalog_root/.seed-$name.XXXXXX")
    cp -R -- "$source"/. "$stage"/
    mv -- "$stage" "$target"
  done
}

setup_runtime() {
  local python_command bundle_output
  local -a bundle_wheels

  command -v python3 >/dev/null || fail "Python 3 is required to create the isolated local runtime"
  python_command=$(command -v python3)
  [[ -f $plugin_root/scripts/verify-runtime-bundle.py && ! -L $plugin_root/scripts/verify-runtime-bundle.py ]] \
    || fail "the runtime bundle verifier is unavailable"
  bundle_output=$(
    "$python_command" "$plugin_root/scripts/verify-runtime-bundle.py" \
      --root "$plugin_root" --print-wheel-paths0 | tr '\0' '\n'
  ) || fail "the release-pinned runtime bundle did not verify"
  mapfile -t bundle_wheels <<<"$bundle_output"
  [[ ${#bundle_wheels[@]} == 2 ]] || fail "the runtime bundle did not provide exactly two wheels"

  if [[ -e $runtime_root || -L $runtime_root ]]; then
    [[ -d $runtime_root && ! -L $runtime_root ]] || fail "the runtime root is not a directory"
  else
    mkdir -p -- "$runtime_root"
  fi

  if ! runtime_available && [[ -e $runtime || -L $runtime ]]; then
    [[ -d $runtime && ! -L $runtime ]] || fail "the incomplete runtime path is not a directory"
    rm -rf -- "$runtime"
  fi
  if ! runtime_available; then
    "$python_command" -m venv "$runtime"
  fi

  PIP_DISABLE_PIP_VERSION_CHECK=1 "$runtime/bin/python" -m pip install \
    --disable-pip-version-check --no-input --only-binary=:all: --require-hashes \
    --force-reinstall --requirement "$plugin_root/runtime/requirements.lock" >&2
  PIP_DISABLE_PIP_VERSION_CHECK=1 "$runtime/bin/python" -m pip install \
    --disable-pip-version-check --no-input --no-index --no-deps --force-reinstall \
    "${bundle_wheels[@]}" >&2
}

case "$action" in
  status)
    if runtime_available; then
      exec "$runtime_cli" status
    fi
    status_json "setup-required" "local-runtime-not-installed"
    ;;
  panel-state)
    if runtime_available; then
      exec "$runtime_cli" panel-state --state-dir "$agent_state_dir" --settings-path "$settings_path" \
        --drafts-path "$drafts_path" --activity-path "$activity_path"
    fi
    status_json "setup-required" "local-runtime-not-installed"
    ;;
  setup)
    setup_runtime
    sync_seed_catalog
    exec "$runtime_cli" agent-reconcile \
      --state-dir "$agent_state_dir" \
      --runtime-cli "$runtime_cli" \
      --catalog "$catalog_root" \
      --settings-path "$settings_path" \
      --drafts-path "$drafts_path" \
      --activity-path "$activity_path"
    ;;
  query)
    runtime_available || { status_json "setup-required" "local-runtime-not-installed"; exit 0; }
    [[ -d $catalog_root && ! -L $catalog_root ]] || fail "the owner-local catalog is unavailable"
    exec "$runtime_cli" query --catalog "$catalog_root" --activity-path "$activity_path"
    ;;
  agent-status)
    runtime_available || { status_json "setup-required" "local-runtime-not-installed"; exit 0; }
    exec "$runtime_cli" agent-status --state-dir "$agent_state_dir" --activity-path "$activity_path"
    ;;
  agent-reconcile)
    runtime_available || { status_json "setup-required" "local-runtime-not-installed"; exit 0; }
    agent_arguments=(agent-reconcile --state-dir "$agent_state_dir" --runtime-cli "$runtime_cli" --catalog "$catalog_root" --settings-path "$settings_path" --drafts-path "$drafts_path" --activity-path "$activity_path")
    for agent in "${additional_agents[@]}"; do
      agent_arguments+=(--additional-agent "$agent")
    done
    exec "$runtime_cli" "${agent_arguments[@]}"
    ;;
  agent-disconnect)
    runtime_available || { status_json "setup-required" "local-runtime-not-installed"; exit 0; }
    exec "$runtime_cli" agent-disconnect --state-dir "$agent_state_dir" --activity-path "$activity_path"
    ;;
  stats)
    runtime_available || { status_json "setup-required" "local-runtime-not-installed"; exit 0; }
    exec "$runtime_cli" stats --activity-path "$activity_path"
    ;;
  settings-show)
    runtime_available || { status_json "setup-required" "local-runtime-not-installed"; exit 0; }
    exec "$runtime_cli" settings-show --settings-path "$settings_path"
    ;;
  settings-apply)
    runtime_available || { status_json "setup-required" "local-runtime-not-installed"; exit 0; }
    exec "$runtime_cli" settings-apply --settings-path "$settings_path"
    ;;
  draft-list)
    runtime_available || { status_json "setup-required" "local-runtime-not-installed"; exit 0; }
    exec "$runtime_cli" draft-list --drafts-path "$drafts_path"
    ;;
  register-method)
    runtime_available || { status_json "setup-required" "local-runtime-not-installed"; exit 0; }
    exec "$runtime_cli" register-method --drafts-path "$drafts_path" --catalog "$catalog_root" \
      --settings-path "$settings_path" --activity-path "$activity_path"
    ;;
  contribution-sync)
    runtime_available || { status_json "setup-required" "local-runtime-not-installed"; exit 0; }
    exec "$runtime_cli" contribution-sync --drafts-path "$drafts_path" --activity-path "$activity_path"
    ;;
  contribution-transition)
    runtime_available || { status_json "setup-required" "local-runtime-not-installed"; exit 0; }
    exec "$runtime_cli" contribution-transition --drafts-path "$drafts_path" --activity-path "$activity_path"
    ;;
  service-activate)
    runtime_available || { status_json "setup-required" "local-runtime-not-installed"; exit 0; }
    exec "$runtime_cli" service-activate --drafts-path "$drafts_path" --activity-path "$activity_path"
    ;;
  service-inspect)
    runtime_available || { status_json "setup-required" "local-runtime-not-installed"; exit 0; }
    service_arguments=(service-inspect --activity-path "$activity_path")
    if [[ -n $profile ]]; then
      [[ $profile == /* && -f $profile ]] || fail "an alternate service profile must be an absolute readable file"
      service_arguments+=(--profile "$profile")
    fi
    exec "$runtime_cli" "${service_arguments[@]}"
    ;;
  service-query)
    runtime_available || { status_json "setup-required" "local-runtime-not-installed"; exit 0; }
    service_arguments=(service-query --activity-path "$activity_path")
    if [[ -n $profile ]]; then
      [[ $profile == /* && -f $profile ]] || fail "an alternate service profile must be an absolute readable file"
      service_arguments+=(--profile "$profile")
    fi
    [[ -z $omarchy_release ]] || service_arguments+=(--omarchy-release "$omarchy_release")
    exec "$runtime_cli" "${service_arguments[@]}"
    ;;
  service-publication)
    runtime_available || { status_json "setup-required" "local-runtime-not-installed"; exit 0; }
    exec "$runtime_cli" service-publication --activity-path "$activity_path"
    ;;
  service-artifact-stage)
    runtime_available || { status_json "setup-required" "local-runtime-not-installed"; exit 0; }
    exec "$runtime_cli" service-artifact-stage --activity-path "$activity_path"
    ;;
  service-artifact-review)
    runtime_available || { status_json "setup-required" "local-runtime-not-installed"; exit 0; }
    exec "$runtime_cli" service-artifact-review --activity-path "$activity_path"
    ;;
  service-artifact-install)
    runtime_available || { status_json "setup-required" "local-runtime-not-installed"; exit 0; }
    exec "$runtime_cli" service-artifact-install --activity-path "$activity_path"
    ;;
  service-artifact-enable)
    runtime_available || { status_json "setup-required" "local-runtime-not-installed"; exit 0; }
    exec "$runtime_cli" service-artifact-enable --activity-path "$activity_path"
    ;;
esac
